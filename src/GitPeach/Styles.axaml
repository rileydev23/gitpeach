<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="#1e1f22" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#2d2e33" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3a3c42" />
  </Style>
  <!-- Split buttons (Pull/Push) look and size exactly like the plain toolbar buttons. -->
  <Style Selector="SplitButton">
    <Setter Property="Background" Value="#2d2e33" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="SplitButton /template/ Button#PART_PrimaryButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5,4" />
  </Style>

  <!-- "Repositorios" launcher in the tab strip: darker, square, separated from the tabs. -->
  <Style Selector="Button.home">
    <Setter Property="Background" Value="#111214" />
    <Setter Property="Foreground" Value="#a8abb2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1f2024" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.home.active">
    <Setter Property="Background" Value="#0d1520" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#4a90d9" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5aa0e9" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#26272b" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33507a" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2d2e33" />
  </Style>

  <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="#3a3c42" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="#8a8d93" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
  </Style>
</Styles>
