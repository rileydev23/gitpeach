<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitPeach.ViewModels"
             xmlns:c="using:GitPeach.Controls"
             xmlns:views="using:GitPeach.Views"
             xmlns:l="using:GitPeach.Services"
             x:Class="GitPeach.Views.RepoView"
             x:DataType="vm:RepoViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding History.FocusSearchCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FetchCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding PullCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding PushCommand}" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding NewBranchCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding StashCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding PopCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding WorkingTree.StageAllCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+U" Command="{Binding WorkingTree.UnstageAllCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding WorkingTree.CommitChangesCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding Log.ToggleCommand}" />
  </UserControl.KeyBindings>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="#26272b" BorderBrush="#3a3c42" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button Content="TextPeach" Command="{Binding OpenInTextPeachCommand}" ToolTip.Tip="{l:L repo.textpeach.tip}" />
          <Button Content="{l:L repo.explorer}" Command="{Binding OpenInExplorerCommand}" />
          <Button Content="Terminal" Command="{Binding OpenInTerminalCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Fetch" Command="{Binding FetchCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{l:L repo.fetch.tip}" />
          <SplitButton Content="Pull" Command="{Binding PullCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Pull (Ctrl+Shift+L)">
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="{l:L repo.pull.default}" Command="{Binding PullCommand}" InputGesture="Ctrl+Shift+L" />
                <MenuItem Header="{l:L repo.pull.rebase}" Command="{Binding PullRebaseCommand}" />
                <MenuItem Header="{l:L repo.pull.ff}" Command="{Binding PullFastForwardCommand}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <SplitButton Content="Push" Command="{Binding PushCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{l:L repo.push.tip}">
            <SplitButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Push" Command="{Binding PushCommand}" InputGesture="Ctrl+Shift+P" />
                <MenuItem Header="{l:L repo.push.toRemote}" Command="{Binding PushToRemoteCommand}" />
                <MenuItem Header="{l:L repo.push.tags}" Command="{Binding PushTagsCommand}" />
                <Separator />
                <MenuItem Header="{l:L repo.push.force}" Command="{Binding PushForceCommand}" />
              </MenuFlyout>
            </SplitButton.Flyout>
          </SplitButton>
          <Border Width="1" Background="#3a3c42" Margin="6,2" />
          <Button Content="{l:L repo.newBranch}" Command="{Binding NewBranchCommand}" ToolTip.Tip="{l:L repo.newBranch.tip}" />
          <Button Content="Stash" Command="{Binding StashCommand}" ToolTip.Tip="{l:L repo.stash.tip}" />
          <Button Content="Pop" Command="{Binding PopCommand}" ToolTip.Tip="{l:L repo.pop.tip}" />
          <Border Width="1" Background="#3a3c42" Margin="6,2" />
          <Button Content="{l:L repo.refresh}" Command="{Binding RefreshCommand}" ToolTip.Tip="F5" />
          <TextBlock Text="{Binding BranchText}" FontWeight="SemiBold" Foreground="#6cc070" VerticalAlignment="Center" Margin="14,0,0,0" />
          <TextBlock Text="{Binding TrackText}" Foreground="#e0a24a" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Merge / rebase banner -->
    <Border DockPanel.Dock="Top" Background="#5a4318" Padding="10,6" IsVisible="{Binding HasOperation}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="{l:L common.continue}" Command="{Binding ContinueOperationCommand}" />
          <Button Content="{l:L common.abort}" Command="{Binding AbortOperationCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding OperationText}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WorkingTree.ConflictText}" IsVisible="{Binding WorkingTree.HasConflicts}" Foreground="#f0c890" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="#18191c" BorderBrush="#3a3c42" BorderThickness="0,1,0,0" Padding="10,3">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="flat" Content="{l:L repo.log}" Command="{Binding Log.ToggleCommand}" Foreground="#8a8d93" ToolTip.Tip="Ctrl+L" />
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" Height="6" Margin="0,0,10,0" />
        <TextBlock Classes="dim" Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="dim" Text="{Binding Notice}" IsVisible="{Binding !IsBusy}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Command log -->
    <Border DockPanel.Dock="Bottom" Background="#18191c" BorderBrush="#3a3c42" BorderThickness="0,1,0,0"
            Height="170" IsVisible="{Binding Log.IsVisible}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top">
          <Button Classes="flat" Content="{l:L common.copy}" Click="OnCopyLog" ToolTip.Tip="{l:L repo.log.copy.tip}" />
          <Button Classes="flat" Content="{l:L repo.log.clear}" Command="{Binding Log.ClearCommand}" />
        </StackPanel>
        <!-- Read-only output: a TextBlock, so it never shows a caret or an input border. -->
        <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding Log.Text}" FontFamily="Consolas, Cascadia Mono, DejaVu Sans Mono, Liberation Mono" FontSize="12" Margin="10,6" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="120" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="2*" MinWidth="300" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="1.3*" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <!-- Sidebar -->
      <Border Background="#222327">
        <ListBox x:Name="SidebarList" ItemsSource="{Binding Sidebar.Items}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarItem">
              <DockPanel Margin="{Binding Pad}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" Foreground="{Binding Foreground}"
                           TextTrimming="CharacterEllipsis" FontSize="12" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Commit list with search -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="#222327" BorderBrush="#3a3c42" BorderThickness="0,0,0,1" Padding="6,4">
          <DockPanel>
            <ComboBox DockPanel.Dock="Left" ItemsSource="{x:Static vm:HistoryViewModel.SearchModes}"
                      SelectedIndex="{Binding History.SearchModeIndex}" Width="118" Margin="0,0,6,0"
                      ToolTip.Tip="{l:L repo.search.mode.tip}" />
            <Button DockPanel.Dock="Right" Classes="flat" Content="✕" Command="{Binding History.ClearSearchCommand}"
                    IsVisible="{Binding History.IsSearching}" ToolTip.Tip="{l:L repo.search.clear.tip}" />
            <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding History.SearchStatus}" VerticalAlignment="Center"
                       Margin="8,0" IsVisible="{Binding History.IsSearching}" />
            <TextBox x:Name="SearchBox" Text="{Binding History.SearchText}" Watermark="{l:L repo.search.watermark}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding History.ClearSearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
          </DockPanel>
        </Border>
        <ListBox x:Name="CommitList" ItemsSource="{Binding History.Commits}" SelectedItem="{Binding History.SelectedCommitRow}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CommitRowVM">
              <Grid ColumnDefinitions="Auto,*,100,125" Height="24">
                <c:GraphCell Row="{Binding Graph}" IsWip="{Binding IsWip}" Width="{Binding Metrics.PixelWidth}" Height="24" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" ClipToBounds="True">
                  <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RefBadge">
                        <Border Background="{Binding Background}" CornerRadius="3" Padding="5,1">
                          <TextBlock Text="{Binding Text}" FontSize="11" Foreground="White" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Subject}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Author}" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,4,0" />
                <TextBlock Grid.Column="3" Text="{Binding DateText}" Classes="dim" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <!-- Right pane -->
      <Grid x:Name="RightGrid" Grid.Column="4" RowDefinitions="360,4,*">
        <Grid x:Name="TopArea">
          <!-- Working tree mode -->
          <Grid RowDefinitions="Auto,*,Auto,*,Auto" IsVisible="{Binding Details.IsWipMode}">
            <DockPanel Margin="8,6">
              <Button DockPanel.Dock="Right" Classes="flat" Content="{l:L repo.stageAll}" Command="{Binding WorkingTree.StageAllCommand}" ToolTip.Tip="Ctrl+Shift+A" />
              <TextBlock Text="{Binding WorkingTree.UnstagedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="UnstagedList" Grid.Row="1" ItemsSource="{Binding WorkingTree.Unstaged}" SelectedItem="{Binding WorkingTree.SelectedUnstaged}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryVM">
                  <Grid ColumnDefinitions="22,*,Auto" Margin="8,2">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                      <TextBlock Text="{Binding Directory}" Classes="dim" />
                      <TextBlock Text="{Binding FileName}" />
                      <TextBlock Text="{l:L repo.conflict.badge}" Foreground="#e0a24a" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsConflict}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                      <Button Classes="flat" Content="↶" Command="{Binding DiscardCommand}" ToolTip.Tip="{l:L common.discard}" IsVisible="{Binding !IsConflict}" />
                      <Button Classes="flat" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" ToolTip.Tip="Stage" FontWeight="Bold" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Row="2" Margin="8,6">
              <Button DockPanel.Dock="Right" Classes="flat" Content="{l:L repo.unstageAll}" Command="{Binding WorkingTree.UnstageAllCommand}" ToolTip.Tip="Ctrl+Shift+U" />
              <TextBlock Text="{Binding WorkingTree.StagedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox x:Name="StagedList" Grid.Row="3" ItemsSource="{Binding WorkingTree.Staged}" SelectedItem="{Binding WorkingTree.SelectedStaged}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileEntryVM">
                  <Grid ColumnDefinitions="22,*,Auto" Margin="8,2">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                      <TextBlock Text="{Binding Directory}" Classes="dim" />
                      <TextBlock Text="{Binding FileName}" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="flat" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" ToolTip.Tip="Unstage" FontWeight="Bold" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="4" Background="#26272b" BorderBrush="#3a3c42" BorderThickness="0,1,0,0" Padding="8">
              <StackPanel Spacing="6">
                <TextBox x:Name="MessageBox" Text="{Binding WorkingTree.CommitMessage}" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" Watermark="{l:L repo.commit.watermark}" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="accent" Content="Commit" Command="{Binding WorkingTree.CommitChangesCommand}" Padding="18,5" ToolTip.Tip="Ctrl+Enter" />
                  <CheckBox Content="{l:L repo.commit.amend}" IsChecked="{Binding WorkingTree.Amend}" />
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Commit mode -->
          <Grid RowDefinitions="Auto,*" IsVisible="{Binding !Details.IsWipMode}">
            <StackPanel Margin="10,8" Spacing="6">
              <SelectableTextBlock Text="{Binding Details.DetailMessage}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" MaxHeight="110" />
              <SelectableTextBlock Text="{Binding Details.DetailMeta}" Classes="mono" Foreground="#8a8d93" FontSize="12" />
            </StackPanel>
            <ListBox x:Name="CommitFilesList" Grid.Row="1" ItemsSource="{Binding Details.CommitFiles}" SelectedItem="{Binding Details.SelectedCommitFile}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CommitFileVM">
                  <Grid ColumnDefinitions="22,*" Margin="8,2">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" ClipToBounds="True">
                      <TextBlock Text="{Binding Directory}" Classes="dim" />
                      <TextBlock Text="{Binding FileName}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

        <views:DiffListView Grid.Row="2" DataContext="{Binding Details.Diff}" />
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
