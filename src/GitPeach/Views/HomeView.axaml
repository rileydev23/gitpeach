<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitPeach.ViewModels"
             x:Class="GitPeach.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#26272b" BorderBrush="#3a3c42" BorderThickness="0,0,0,1" Padding="10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="6">
          <Button Classes="accent" Content="Agregar repositorio..." Command="{Binding AddCommand}" />
          <Button Content="Escanear carpeta..." Command="{Binding ScanCommand}"
                  ToolTip.Tip="Busca los repositorios dentro de una carpeta y los agrupa con el nombre de esa carpeta" />
          <Button Content="Clonar..." Command="{Binding CloneCommand}" />
          <Button Content="Nuevo grupo..." Command="{Binding NewGroupCommand}" />
          <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
          <Button Classes="flat" Content="▾ Expandir" Command="{Binding ExpandAllCommand}" ToolTip.Tip="Expandir todos los grupos" />
          <Button Classes="flat" Content="▸ Contraer" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Contraer todos los grupos" />
          <ToggleButton Content="★ Favoritos" IsChecked="{Binding OnlyFavorites}" />
        </StackPanel>
        <TextBox Text="{Binding Filter}" Watermark="Filtrar repositorios..." Margin="12,0,0,0" x:Name="FilterBox" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#18191c" BorderBrush="#3a3c42" BorderThickness="0,1,0,0" Padding="10,4">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding Busy}" Width="120" Height="6" />
        <TextBlock Classes="dim" Text="{Binding Status}" />
      </DockPanel>
    </Border>

    <Grid>
      <ListBox x:Name="RepoList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Multiple">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:GroupHeaderRow" x:DataType="vm:GroupHeaderRow">
            <Border Background="#222327" BorderBrush="#3a3c42" BorderThickness="0,1,0,1" Padding="4,2">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="flat" Content="Abrir todos" Command="{Binding OpenAllCommand}"
                        IsVisible="{Binding CanOpenAll}" Foreground="#8a8d93" VerticalAlignment="Center"
                        ToolTip.Tip="Abrir todos los repositorios del grupo en pestañas" />
                <Button Classes="flat" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Padding="4,4">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Chevron}" Width="14" FontSize="16" Foreground="#8a8d93" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="vm:RepoRow" x:DataType="vm:RepoRow">
            <Grid ColumnDefinitions="28,*,Auto" Margin="{Binding Pad}">
              <TextBlock Text="★" Foreground="#e0a24a" IsVisible="{Binding Entry.Favorite}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Entry.Name}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="{Binding Entry.Branch}" Foreground="#6cc070" VerticalAlignment="Center" />
                  <TextBlock Text="(carpeta no encontrada)" Foreground="#e0645a" IsVisible="{Binding Entry.Missing}" />
                </StackPanel>
                <TextBlock Text="{Binding Entry.Path}" Classes="dim" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center"
                         Text="{Binding Entry.LastOpened, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsHitTestVisible="False"
                  IsVisible="{Binding IsEmpty}">
        <TextBlock Text="No hay repositorios en la lista" FontSize="16" HorizontalAlignment="Center" />
        <TextBlock Classes="dim" Text="Agrega uno, escanea una carpeta o arrastra carpetas a esta ventana." />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
