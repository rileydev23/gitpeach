<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitPeach.ViewModels"
        xmlns:views="using:GitPeach.Views"
        x:Class="GitPeach.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GitPeach"
        Icon="/Assets/app.ico"
        MinWidth="800" MinHeight="500"
        DragDrop.AllowDrop="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+P" Command="{Binding QuickOpenCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCurrentCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
    <KeyBinding Gesture="F1" Command="{Binding ShowAboutCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding SelectTabCommand}" CommandParameter="1" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding SelectTabCommand}" CommandParameter="2" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding SelectTabCommand}" CommandParameter="3" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding SelectTabCommand}" CommandParameter="4" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding SelectTabCommand}" CommandParameter="5" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding SelectTabCommand}" CommandParameter="6" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding SelectTabCommand}" CommandParameter="7" />
    <KeyBinding Gesture="Ctrl+D8" Command="{Binding SelectTabCommand}" CommandParameter="8" />
    <KeyBinding Gesture="Ctrl+D9" Command="{Binding SelectTabCommand}" CommandParameter="9" />
  </Window.KeyBindings>

  <DockPanel>
    <!-- Tab strip -->
    <Border DockPanel.Dock="Top" Background="#18191c" BorderBrush="#3a3c42" BorderThickness="0,0,0,1">
      <DockPanel>
      <Button DockPanel.Dock="Right" Classes="flat" Content="?" Command="{Binding ShowAboutCommand}"
              ToolTip.Tip="Acerca de y atajos de teclado (F1)" Foreground="#8a8d93" Margin="0,0,8,0" VerticalAlignment="Center" />
      <!-- Home: a fixed launcher, visually a level above the repository tabs -->
      <Button DockPanel.Dock="Left" Classes="home" Classes.active="{Binding IsHomeSelected}"
              Command="{Binding ShowHomeCommand}" ToolTip.Tip="Lista de repositorios">
        <Grid RowDefinitions="*,Auto">
          <TextBlock Text="Repositorios" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0" />
          <Border Grid.Row="1" Height="2" Background="#4a90d9" IsVisible="{Binding IsHomeSelected}" />
        </Grid>
      </Button>
      <ListBox Classes="tabstrip" ItemsSource="{Binding RepoTabs}" SelectedItem="{Binding SelectedRepoTab}" Margin="4,0,0,0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RepoViewModel">
            <StackPanel Orientation="Horizontal" Margin="12,7,6,7" Spacing="8">
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              <Button Classes="flat" Content="✕" Command="{Binding CloseCommand}" FontSize="10" Padding="4,1"
                      Foreground="#8a8d93" VerticalAlignment="Center" ToolTip.Tip="Cerrar (Ctrl+W)" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </DockPanel>
    </Border>

    <ContentControl Content="{Binding SelectedTab}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:RepoViewModel"><views:RepoView /></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
