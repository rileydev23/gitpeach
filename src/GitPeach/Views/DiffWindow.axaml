<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitPeach.ViewModels"
        xmlns:l="using:GitPeach.Services"
        xmlns:views="using:GitPeach.Views"
        x:Class="GitPeach.Views.DiffWindow"
        x:DataType="vm:DetailsViewModel"
        Title="{Binding Title, StringFormat='{}{0} — Diff'}"
        Icon="/Assets/app.ico"
        Width="1100" Height="800" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#26272b" BorderBrush="#3a3c42" BorderThickness="0,0,0,1"
            Padding="12,8" IsVisible="{Binding !IsWipMode}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding DetailMessage}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" MaxHeight="90" />
        <TextBlock Text="{Binding DetailMeta}" Classes="dim mono" FontSize="12" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="#26272b" BorderBrush="#3a3c42" BorderThickness="0,0,0,1"
            Padding="12,8" IsVisible="{Binding IsWipMode}">
      <TextBlock Classes="dim" Text="{l:L diff.wipWindow}" />
    </Border>
    <views:DiffListView x:Name="Diff" DataContext="{Binding Diff}" />
  </DockPanel>
</Window>
